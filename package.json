{
    "name": "scraper-challenge",
    "version": "1.0.0",
    "description": "Scraper en TypeScript de jurisprudencia del Poder Judicial con resiliencia de ViewState e idempotencia",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/main.ts",
        "start": "ts-node src/main.ts",
        "retry-failed": "ts-node src/retryFailed.ts",
        "test": "ts-node test/runTests.ts",
        "build": "tsc",
        "start:prod": "node dist/main.js",
        "start:mock": "ts-node test/mockServer.ts"
    },
    "keywords": [
        "scraper",
        "typescript",
        "jsf",
        "richfaces",
        "axios"
    ],
