    "license": "ISC",
    "dependencies": {
        "axios": "^1.6.8",
        "axios-cookiejar-support": "^5.0.1",
        "cheerio": "^1.0.0-rc.12",
        "fast-xml-parser": "^4.3.6",
        "tough-cookie": "^4.1.3"
    },
    "devDependencies": {
        "@types/cheerio": "^0.22.35",
        "@types/node": "^20.11.24",
        "@types/tough-cookie": "^4.0.5",
        "express": "^4.18.3",
        "@types/express": "^4.17.21",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}